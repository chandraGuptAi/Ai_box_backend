# ---- DeepSeek (server-side only; never expose to Angular) ----
Ai_box_key=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=120
DEEPSEEK_MAX_RETRIES=0
DEEPSEEK_MAX_OUTPUT_TOKENS=4096
# Compact/dashboard/summary limit; truncation retries once at the full limit above.
DEEPSEEK_COMPACT_OUTPUT_TOKENS=1600
# Metadata-only DeepSeek execution plan before fetching; grounded narrative after Python metrics. Default true.
REPORT_AI_PLANNER=true
# true: a shipment report stops (422 incomplete_source / scope_mismatch) when fewer shipments arrive than the
# source matched, or received shipments fall outside the selected dates/status. Requests can still send
# allow_partial=true for a report labelled partial.
REPORT_REQUIRE_COMPLETE_SOURCE=true
# Whole /api/reports/generate request (shipment fetch + analysis + DeepSeek); exceeded -> 504.
REPORT_DEADLINE_SECONDS=170

# --- Backend-owned shipment fetch (source="shipment_api") ---
# Origin of the BigShip order-list API (https, no path). Empty disables the mode (503).
# The path /api/get-order-list is fixed; requests can never choose the host.
# Staging example: https://intlstagingapi.bigship.in
SHIPMENT_API_BASE_URL=
# Authentication: the caller's own BigShip login token, sent by Angular as
# X-Shipment-Authorization: Bearer <token> and forwarded only to this host. No server credential is stored.
SHIPMENT_API_CONNECT_TIMEOUT=5
SHIPMENT_API_READ_TIMEOUT=30
# All upstream calls of one report together.
SHIPMENT_API_TOTAL_TIMEOUT=60
# Per call, for timeouts, network errors and 5xx only. 401/403/429/4xx are never retried.
SHIPMENT_API_RETRIES=1
# Whole re-reads when the source changed during the fetch (total changed, rows shifted between pages).
SHIPMENT_API_FETCH_ATTEMPTS=2
# More matching shipments than this -> 422 source_too_large ("select a shorter date range").
SHIPMENT_API_MAX_RECORDS=5000
# Pages are sized from the matching total (total / concurrency, at least MIN_PAGE_SIZE, at most
# MAX_PAGE_SIZE) and read concurrently; a page the API cannot serve (5xx/timeout) is split in half.
SHIPMENT_API_CONCURRENCY=4
# Results above this are read as date windows split at local midnights, each in one page
# (the order-list API fails on deep pages of large results).
SHIPMENT_API_WINDOW_RECORDS=500
SHIPMENT_API_MIN_PAGE_SIZE=100
SHIPMENT_API_MAX_PAGE_SIZE=5000
SHIPMENT_API_MAX_REQUESTS=30
SHIPMENT_API_MAX_RESPONSE_BYTES=67108864
# perPage of the first (matching-count) request.
SHIPMENT_API_COUNT_PAGE_SIZE=1
# Selectable date fields, each sent verbatim as date_filter_type. Only documented values.
SHIPMENT_API_DATE_FIELDS=manifest_datetime
SHIPMENT_API_MAX_RANGE_DAYS=186
# Optional per-million-token rates in your billing currency. Blank = no cost estimate.
DEEPSEEK_INPUT_COST_PER_MILLION=
DEEPSEEK_OUTPUT_COST_PER_MILLION=
DEEPSEEK_TEMPERATURE=0.2

# ---- App ----
APP_ENV=development
LOG_LEVEL=INFO
# Set to false in production to hide /docs, /redoc and /openapi.json
ENABLE_DOCS=true
# Local testing only (e.g. Swagger without headers): user ID for requests that send no X-User-Id.
# Leave empty everywhere else; empty rejects such requests with 401.
AI_BOX_DEV_USER_ID=

# ---- CORS: comma-separated list of allowed browser origins ----
CORS_ALLOWED_ORIGINS=http://localhost:4200

# ---- Limits ----
MAX_REQUEST_BYTES=10485760
MAX_RECORDS=20000
MAX_PROMPT_CHARS=2000
# Legacy analyzer setting. Intent-driven shipment prompts send aggregates only.
AI_SAMPLE_RECORDS=25

# ---- Output ----
# When true, a private copy of each exported file is written to OUTPUT_DIR (never served over HTTP)
SAVE_GENERATED_FILES=false
OUTPUT_DIR=output

# ---- PDF fonts (optional; a Unicode TTF is auto-detected on Windows/Linux) ----
PDF_FONT_REGULAR=
PDF_FONT_BOLD=

# ---- PostgreSQL (Docker; local development credentials) ----
POSTGRES_DB=ai_box
POSTGRES_USER=ai_box
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5434
# Host Python only: URL-encode credentials. Docker constructs its own URL.
DATABASE_URL=postgresql://ai_box:replace_with_url_encoded_password@127.0.0.1:5434/ai_box
BACKEND_PORT=8000
APP_NAME=AI Box Report Backend
APP_VERSION=1.0.0
REPORT_DETERMINISTIC_FALLBACK=true
# false: log accuracy failures and allow delivery; true: block failed numerical checks with 422.
REPORT_ACCURACY_STRICT=false
## Optional shared stable secret (at least 32 bytes); blank uses OUTPUT_DIR/.report_revision.key.
REPORT_VALIDATION_SIGNING_KEY=
# Production: APP_ENV=production, ENABLE_DOCS=false, set actual frontend origin.

# Admin key for GET /api/admin/audit/* (X-Audit-Key header). Empty disables the audit API.
AI_BOX_AUDIT_API_KEY=
