# Append selected values to the existing Python .env; never replace it.
# Default is a separate SQLite file. Optional PostgreSQL URL uses a private schema.
ESCALATION_DATABASE_URL=
ESCALATION_SQLITE_PATH=
WHATSAPP_SIDECAR_URL=http://127.0.0.1:3101
WHATSAPP_SIDECAR_SECRET=
ESCALATION_DEEPSEEK_API_KEY=
ESCALATION_DEEPSEEK_MODEL=deepseek-v4-pro
ESCALATION_DEEPSEEK_BASE_URL=https://api.deepseek.com
ESCALATION_DEEPSEEK_REASONING=max
ESCALATION_DEEPSEEK_MAX_TOKENS=80000
GEMINI_API_KEY=
GEMINI_MEDIA_MODEL=gemini-3.1-flash-lite
RECIPIENT_NUMBER=
ESCALATION_SCHEDULER_ENABLED=false
ESCALATION_RETENTION_DAYS=30
